MONGODB_URL=mongodb+srv://<username>:<password>@<cluster-url>/
DATABASE_NAME=employee_db
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# SMTP settings used to email employee account invitations
FRONTEND_URL=http://localhost:5173
# Optional: set this if the Tesseract executable is not on your system PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com



